{
  "name": "tatami.ninja — embroidery digitizer",
  "short_name": "tatami.ninja",
  "description": "Free, open-source embroidery digitizer that runs in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1B1C1F",
